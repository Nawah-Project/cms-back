# Runtime
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://app.example.com
TRUST_PROXY=1
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
VITE_API_URL=https://api.example.com

# Authentication: generate two different random values with at least 32 bytes each.
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
AUTH_COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
ACCESS_TOKEN_TTL_SECONDS=1200
REFRESH_TOKEN_TTL_SECONDS=1209600

# PostgreSQL. DATABASE_URL_DOCKER must use the postgres service host in Compose.
POSTGRES_USER=cms
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=cms
DATABASE_URL=postgresql://cms:REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD@localhost:5432/cms?schema=public
DATABASE_URL_DOCKER=postgresql://cms:REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD@postgres:5432/cms?schema=public
TEST_DATABASE_URL=postgresql://cms:URL_ENCODED_PASSWORD@localhost:5432/cms_test?schema=public

# Private CV storage (must be mounted persistently in production).
CV_STORAGE_DIR=/app/private-storage/cvs
CV_MAX_FILE_SIZE_BYTES=5242880

# Optional Google OAuth: configure all three values or leave all blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
