# API
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (local Docker Compose)
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms_local_dev_password
POSTGRES_DB=cms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cms:cms_local_dev_password@localhost:5432/cms?schema=public

# Dedicated PostgreSQL database for integration tests
TEST_DATABASE_URL=postgresql://cms:cms_local_dev_password@localhost:5432/cms_test?schema=public

# Set distinct, random values in production (at least 32 bytes each).
JWT_ACCESS_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
