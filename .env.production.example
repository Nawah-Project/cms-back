NODE_ENV=production
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=nawah_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_DB_PASSWORD
POSTGRES_DB=nawah_cms
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://nawah_prod_user:CHANGE_THIS_TO_A_STRONG_DB_PASSWORD@postgres:5432/nawah_cms?schema=public
DATABASE_URL_DOCKER=postgresql://nawah_prod_user:CHANGE_THIS_TO_A_STRONG_DB_PASSWORD@postgres:5432/nawah_cms?schema=public

# JWT Secrets (Must be >= 32 bytes each, distinct, and must NOT contain words like replace/example/secret)
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=9f8d7a6b5c4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a
JWT_REFRESH_SECRET=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b
ACCESS_TOKEN_TTL_SECONDS=1200
REFRESH_TOKEN_TTL_SECONDS=1209600

# Public HTTPS Origins (Must use https:// in production, no trailing path)
FRONTEND_ORIGIN=https://app.yourdomain.com
VITE_API_URL=https://api.yourdomain.com

# Cookie & Proxy Security
AUTH_COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
TRUST_PROXY=1

# Host Port Bindings (for Nginx / Caddy Reverse Proxy)
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=8081

# CV Storage
CV_STORAGE_DIR=/app/private-storage/cvs
CV_MAX_FILE_SIZE_BYTES=5242880

# Optional Google OAuth (Leave all 3 empty or set all 3 with https://)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
