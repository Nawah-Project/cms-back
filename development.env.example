# Copy to /data/cms-development/.env and generate unique secrets before deployment.
# The password must be URL-safe (hex is recommended) because it forms DATABASE_URL.
DEV_POSTGRES_USER=cms_dev
DEV_POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_URL_SAFE_PASSWORD
DEV_POSTGRES_DB=cms_development
DEV_JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
DEV_JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES

# Development is exposed on loopback only. Reach it through SSH port forwarding.
DEV_API_HOST_PORT=3302
DEV_FRONTEND_HOST_PORT=5174
DEV_FRONTEND_ORIGIN=http://localhost:5174
DEV_VITE_API_URL=http://localhost:3302
DEV_CV_MAX_FILE_SIZE_BYTES=5242880
DEV_VITE_CV_MAX_FILE_SIZE_BYTES=5242880
DEV_ACCESS_TOKEN_TTL_SECONDS=1200
DEV_REFRESH_TOKEN_TTL_SECONDS=1209600
