generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStage {
  APPLIED
  INTERVIEW
  DECISION
  CLOSED
}

enum ApplicationOutcome {
  NONE
  ACCEPTED
  REJECTED
  WITHDRAWN
  NO_RESPONSE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskSource {
  PERSONAL
  MENTOR_ASSIGNED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskNoteType {
  MENTOR_FEEDBACK
  PERSONAL_NOTE
}

enum FeedbackVisibility {
  DIRECT
  GROUP
  ALL
}

enum FeedbackContext {
  APPLICATION
  INTERVIEW
  WAITING
  DECISION
  GENERAL
}

enum FeedbackTag {
  INTERVIEW
  CV
  COMMUNICATION
  TECHNICAL
  APPLICATIONS
  LEARNING
  GENERAL
}

enum ApplicationMethod {
  COMPANY_WEBSITE
  LINKEDIN
  REFERRAL
  EMAIL
  RECRUITMENT_PLATFORM
  DIRECT_CONTACT
  OTHER
}

enum AuthProvider {
  GOOGLE
}

enum UserRole {
  USER
  ADMIN
}

enum JourneyNodeType {
  ONBOARDING_QUEST // المهمة صفر
  MAIN_QUEST       // المهمات 1 إلى 5 في كل أسبوع
  REVIEW_STATION   // محطة اليوم السابع (التقييم والتعديل 1, 2, 3)
  FINAL_REPORT     // التقرير النهائي في نهاية الأسبوع الرابع
}

enum SideTaskType {
  LINKEDIN_POST    // منشور
  OUTREACH_CONTACT // تواصل وبناء علاقات
  WEEKLY_REVIEW    // تسليم مراجعة وتعديل اليوم السابع
}

enum OutreachStatus {
  SENT
  REPLIED
  REFERRED
  NO_RESPONSE
}

model User {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  email                       String                       @unique
  passwordHash                String?
  refreshTokenHash            String?
  role                        UserRole                     @default(USER)
  emailVerified               Boolean                      @default(false)
  emailVerifiedAt             DateTime?
  emailVerificationCodeHash   String?                      @db.VarChar(128)
  emailVerificationExpiresAt  DateTime?
  emailVerificationSentAt     DateTime?
  emailVerificationAttempts   Int                          @default(0)
  portfolioUrl                String?                      @db.VarChar(2048)
  targetJobTitle              String?                      @db.VarChar(150)
  preferredLocations          String[]                     @default([])
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  membership          Membership?
  applications        Application[]
  transitions         ApplicationStageTransition[]
  authIdentities      AuthIdentity[]
  cv                  UserCv?
  assignedTasks       Task[]                       @relation("TaskAssignee")
  createdTasks        Task[]                       @relation("TaskCreator")
  taskNotes           TaskNote[]                   @relation("TaskNoteAuthor")
  authoredFeedback    FeedbackPost[]               @relation("FeedbackAuthor")
  targetedFeedback    FeedbackPost[]               @relation("FeedbackTarget")
  feedbackReads       FeedbackRead[]
  journeyState        UserJourneyState?
  sideTaskSubmissions SideTaskSubmission[]
  notifications       Notification[]

  @@map("users")
}

model UserCv {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  storageKey   String   @unique @db.VarChar(64)
  uploadedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_cvs")
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String
  providerEmail   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject], map: "UQ_auth_identities_provider_subject")
  @@index([userId], map: "IDX_auth_identities_userId")
  @@map("auth_identities")
}

model Group {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  feedbackPosts FeedbackPost[]

  @@map("member_groups")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  groupId   String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([groupId], map: "IDX_memberships_group")
  @@map("memberships")
}

model Application {
  id                String                       @id @default(uuid()) @db.Uuid
  userId            String                       @db.Uuid
  companyName       String
  jobTitle          String
  applicationDate   String
  location          String?
  applicationMethod ApplicationMethod?
  jobUrl            String?
  stage             ApplicationStage             @default(APPLIED)
  outcome           ApplicationOutcome           @default(NONE)
  isTailored        Boolean                      @default(false)
  journeyWeek       Int                          @default(1)
  hasAssignment     Boolean                      @default(false)
  interviewDate     DateTime?
  prepChecklist     Json?
  interviewNotes    String?                      @db.Text
  sharedWithGroup   Boolean                      @default(false)
  closedAt          DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transitions       ApplicationStageTransition[]

  @@index([userId], map: "IDX_applications_userId")
  @@index([userId, stage], map: "IDX_applications_userId_stage")
  @@index([userId, outcome], map: "IDX_applications_userId_outcome")
  @@index([userId, applicationDate], map: "IDX_applications_userId_applicationDate")
  @@index([userId, updatedAt], map: "IDX_applications_userId_updatedAt")
  @@index([userId, companyName], map: "IDX_applications_userId_companyName")
  @@index([createdAt], map: "IDX_applications_createdAt")
  @@index([stage, outcome, applicationDate], map: "IDX_applications_open_applicationDate")
  @@map("applications")
}

model Task {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  createdById    String              @db.Uuid
  source         TaskSource          @default(MENTOR_ASSIGNED)
  title          String              @db.VarChar(200)
  description    String?             @db.VarChar(5000)
  status         TaskStatus          @default(TODO)
  priority       TaskPriority        @default(MEDIUM)
  mentorPriority Boolean             @default(false)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)
  createdBy      User                @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  checklist      TaskChecklistItem[]
  notes          TaskNote[]

  @@index([userId], map: "IDX_tasks_userId")
  @@index([createdById], map: "IDX_tasks_createdById")
  @@index([source], map: "IDX_tasks_source")
  @@index([status], map: "IDX_tasks_status")
  @@index([dueDate], map: "IDX_tasks_dueDate")
  @@index([mentorPriority], map: "IDX_tasks_mentorPriority")
  @@index([userId, status, dueDate], map: "IDX_tasks_user_status_dueDate")
  @@map("professional_tasks")
}

model TaskChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  title     String   @db.VarChar(300)
  completed Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position], map: "IDX_task_checklist_task_position")
  @@map("task_checklist_items")
}

model TaskNote {
  id        String       @id @default(uuid()) @db.Uuid
  taskId    String       @db.Uuid
  authorId  String       @db.Uuid
  type      TaskNoteType
  content   String       @db.VarChar(5000)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  readAt    DateTime?
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User         @relation("TaskNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "IDX_task_notes_taskId")
  @@index([authorId], map: "IDX_task_notes_authorId")
  @@index([type], map: "IDX_task_notes_type")
  @@index([readAt], map: "IDX_task_notes_readAt")
  @@index([taskId, type, readAt], map: "IDX_task_notes_task_type_readAt")
  @@map("task_notes")
}

model FeedbackPost {
  id                String             @id @default(uuid()) @db.Uuid
  authorId          String             @db.Uuid
  title             String             @db.VarChar(200)
  content           String             @db.VarChar(20000)
  visibility        FeedbackVisibility
  groupId           String?            @db.Uuid
  targetUserId      String?            @db.Uuid
  context           FeedbackContext    @default(GENERAL)
  tags              FeedbackTag[]      @default([])
  unlockTriggerCode String?            @db.VarChar(100)
  promptTemplate    String?            @db.Text
  tierLevel         String?            @default("BASIC")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  publishedAt       DateTime           @default(now())
  archivedAt        DateTime?
  author            User               @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  group             Group?             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  targetUser        User?              @relation("FeedbackTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  resources         FeedbackResource[]
  reads             FeedbackRead[]

  @@index([authorId], map: "IDX_feedback_posts_authorId")
  @@index([visibility], map: "IDX_feedback_posts_visibility")
  @@index([groupId], map: "IDX_feedback_posts_groupId")
  @@index([targetUserId], map: "IDX_feedback_posts_targetUserId")
  @@index([publishedAt], map: "IDX_feedback_posts_publishedAt")
  @@index([archivedAt], map: "IDX_feedback_posts_archivedAt")
  @@index([visibility, archivedAt, publishedAt], map: "IDX_feedback_posts_feed")
  @@index([groupId, archivedAt, publishedAt], map: "IDX_feedback_posts_group_feed")
  @@index([targetUserId, archivedAt, publishedAt], map: "IDX_feedback_posts_direct_feed")
  @@map("feedback_posts")
}

model FeedbackResource {
  id          String       @id @default(uuid()) @db.Uuid
  feedbackId  String       @db.Uuid
  title       String       @db.VarChar(200)
  url         String       @db.VarChar(2048)
  type        String?      @db.VarChar(50)
  description String?      @db.VarChar(1000)
  createdAt   DateTime     @default(now())
  feedback    FeedbackPost @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId], map: "IDX_feedback_resources_feedbackId")
  @@map("feedback_resources")
}

model FeedbackRead {
  id         String       @id @default(uuid()) @db.Uuid
  feedbackId String       @db.Uuid
  userId     String       @db.Uuid
  readAt     DateTime     @default(now())
  feedback   FeedbackPost @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId], map: "UQ_feedback_reads_feedback_user")
  @@index([userId, readAt], map: "IDX_feedback_reads_user_readAt")
  @@index([feedbackId], map: "IDX_feedback_reads_feedbackId")
  @@map("feedback_reads")
}

model ApplicationStageTransition {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @db.Uuid
  userId        String              @db.Uuid
  fromStage     ApplicationStage
  toStage       ApplicationStage
  outcome       ApplicationOutcome?
  changedAt     DateTime            @default(now())
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "IDX_stage_transitions_application")
  @@index([applicationId, toStage, changedAt], map: "IDX_stage_transitions_application_stage_changed")
  @@index([userId, changedAt], map: "IDX_stage_transitions_user_changed")
  @@index([applicationId, changedAt], map: "IDX_stage_transitions_application_changed")
  @@index([changedAt], map: "IDX_stage_transitions_changed")
  @@map("application_stage_transitions")
}

model JourneyNode {
  id                     String          @id @default(uuid()) @db.Uuid
  code                   String          @unique @db.VarChar(50) // مثل: TASK_0, W1_M1..W1_M5, W1_REVIEW, W2_M1...
  weekNumber             Int             // 0 للمهمة صفر، و 1..4 للأسابيع الأربعة
  orderIndex             Int             // الترتيب المتسلسل العام (0, 1, 2, 3...)
  nodeType               JourneyNodeType @default(MAIN_QUEST)
  titleAr                String          @db.VarChar(200)
  titleEn                String          @db.VarChar(200)
  descriptionAr          String?         @db.Text
  descriptionEn          String?         @db.Text
  durationDays           Int             @default(1) // 1 للمهام 1-4، و 2 للمهمة الخامسة، و 1 لليوم السابع
  requiredAppsCount      Int             @default(0) // عدد الطلبات العامة المطلوبة في هذه العقدة
  requiredTailoredCount  Int             @default(0) // عدد الطلبات الخاصة (طلب خاص) المطلوبة
  requiredPostsCount     Int             @default(0) // عدد المنشورات (منشور) المطلوبة
  requiredOutreachCount  Int             @default(0) // عدد التواصل (تواصل) المطلوب
  unlocksInsightCode     String?         @db.VarChar(100) // كود الملاحظة التي تفتح عند إتمام هذه العقدة
  nextNodeCode           String?         @db.VarChar(50)  // كود العقدة التالية التي ينقشع عنها الضباب
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([weekNumber, orderIndex])
  @@map("journey_nodes")
}

model UserJourneyState {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentWeek          Int      @default(0) // يبدأ من 0 (المهمة صفر) ثم 1، 2، 3، 4
  currentNodeCode      String   @default("TASK_0") @db.VarChar(50)
  currentNodeStartedAt DateTime @default(now())
  weekStartedAt        DateTime @default(now())
  completedNodeCodes   String[] @default([])
  unlockedInsightCodes String[] @default([])
  isGroupUnlocked      Boolean  @default(false) // يفتح بعد إتمام TASK_0 (5 طلبات)
  canUseTableView      Boolean  @default(false) // يفتح بعد إتمام W1_M1 (10 طلبات في الأسبوع 1)
  hasUnlockedAdvPrep   Boolean  @default(false) // يفتح عند أول INTERVIEW أو hasAssignment
  cvVersionNumber      Int      @default(1)
  updatedAt            DateTime @updatedAt

  @@map("user_journey_states")
}

model SideTaskSubmission {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeCode      String          @db.VarChar(50)
  journeyWeek   Int
  type          SideTaskType
  // حقول خاصة بـ LINKEDIN_POST
  postUrl       String?         @db.VarChar(2048)
  postTopic     String?         @db.VarChar(300)
  // حقول خاصة بـ OUTREACH_CONTACT
  applicationId String?         @db.Uuid
  contactName   String?         @db.VarChar(150)
  contactRole   String?         @db.VarChar(150)
  companyName   String?         @db.VarChar(200)
  contactMethod String?         @db.VarChar(100)
  contactUrl    String?         @db.VarChar(2048)
  outreachState OutreachStatus? @default(SENT)
  // حقول خاصة بـ WEEKLY_REVIEW
  reviewSummary String?         @db.Text
  newCvUploaded Boolean         @default(false)
  sharedInGroup Boolean         @default(true)
  createdAt     DateTime        @default(now())

  @@index([userId, nodeCode, type])
  @@index([userId, journeyWeek])
  @@map("side_task_submissions")
}

model DomainEventLog {
  id           String   @id @default(uuid()) @db.Uuid
  eventName    String   @db.VarChar(100)
  actorId      String?  @db.Uuid
  targetUserId String?  @db.Uuid
  groupId      String?  @db.Uuid
  entityType   String   @db.VarChar(50)
  entityId     String?  @db.VarChar(100)
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([eventName, createdAt(sort: Desc)])
  @@map("domain_event_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(50) // QUEST_UNLOCKED, INSIGHT_UNLOCKED, GROUP_ACTIVITY, INTERVIEW_PREP
  titleAr   String    @db.VarChar(255)
  titleEn   String    @db.VarChar(255)
  bodyAr    String    @db.Text
  bodyEn    String    @db.Text
  actionUrl String?   @db.VarChar(500)
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}
