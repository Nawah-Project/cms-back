{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "setupFiles": [
    "<rootDir>/load-env.ts"
  ],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/"
  ],
  "setupFilesAfterEnv": [
    "<rootDir>/setup-processors.ts"
  ],
  "testTimeout": 30000
}
